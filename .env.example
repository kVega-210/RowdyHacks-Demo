# Copy to .env and fill in what you have. Everything is optional: the game runs fully offline without any of it.

# Port and the URL phones should use (shown as a QR on the host screen). Defaults: 7070 and your LAN IP.
PORT=7070
# PUBLIC_URL=https://heisthavoc.example

# Signs the physical key tags (PH-01). Set this before printing tags; changing it invalidates printed tags.
HEIST_KEY_SECRET=change-me-to-a-long-random-string

# Event log (DB-01/02). Tiger Data / Postgres connection string. Unset = JSONL files in data/events/.
# DATABASE_URL=postgres://tsdbadmin:password@xxxx.tsdb.cloud.timescale.com:34567/tsdb?sslmode=require

# Gemini (AI-01 dares, AI-02 roast). Unset = template fallbacks.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs narrator (AU-02 batch, AU-04 named lines). Unset = Web Speech API fallback on the host.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Debug: run game time faster than real time (bots/smoke testing only).
# HEIST_TIME_SCALE=1
